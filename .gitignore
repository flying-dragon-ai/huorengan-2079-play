# ============================================================
# 依赖（可由 package.json / tools/lux3d/package.json 复现）
# ============================================================
node_modules/

# ============================================================
# 构建产物（npm run build / build:viewer 可重建）
# ============================================================
dist/
*.tmp
*.tmp-*

# ============================================================
# 测试产物
# ============================================================
coverage/
# 验收截图（QA 脚本输出目录）
tests/e2e/shots/
# 旧布局，已迁到 tests/e2e/shots/；保留规则防止脚本回退
_shots/
*.log

# ============================================================
# 根目录散落的参考图（正本在 docs/参考图/）
# ============================================================
/*.jpeg
/*.jpg
/*.png

# ============================================================
# 生成任务中间产物（Tripo CLI）
# ============================================================
# 当前布局：脚本在 tools/tripo/run_batch.sh，产物落 tools/tripo/out/
tools/tripo/out/
# 旧布局（四层重构前的仓库根 tripo-out/），保留规则防止脚本回退
tripo-out/
# CLI 会话状态，机器本地
.tripo/

# ============================================================
# 资产管线中间产物（Blender 重烘可重建）
# 运行时只用 assets/models/naiwa_animated.glb
# ============================================================
assets/models/naiwa_apose.glb
assets/models/naiwa_baked.glb
assets/models/naiwa_morph_*.glb
assets/models/naiwa_web.glb

# bpy 脚本的输出目录（原 blender/out/，随目录一起迁到 tools/assets/）
tools/assets/blender/out/

# 原始高模（73.7 MB，代码零引用，仅作本地存档）
assets/models/source/

# ============================================================
# 缓存与本地实验产物（都可重跑，不进 git）
# ============================================================
# .cache/autoresearch/  = tools/qa/bench_mobile.mjs 每次跑分写的 JSON + 截图
# .cache/diag_*.json    = 临时诊断落盘
# .cache/probe*.mjs     = 一次性探针脚本
.cache/
.eslintcache
.vitest/
# tools/migrate/dryrun.mjs 的预演目录
.layertest/

# ============================================================
# 本地环境
# ============================================================
.env
.env.local
.server.log

# ============================================================
# 系统垃圾
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ============================================================
# 编辑器
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================
# 例外：这些必须入库
# ============================================================
# 当前仓库并未整体忽略 assets/models/*.glb，这条否定规则是安全网：
# 万一将来有人加上宽规则 assets/models/*.glb，主角模型不会被误伤。
!assets/models/naiwa_animated.glb
